# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# Dados e modelos: o conteúdo NÃO vai para o Git, mas os ponteiros do DVC (*.dvc) vão.
# As pastas precisam continuar "visíveis" (!/data/**/) para que o Git consiga enxergar o
# .dvc lá dentro: ignorar a pasta inteira esconderia a exceção junto (Etapa 3).
/data/**
!/data/**/
!/data/**/*.dvc
!/data/**/.gitkeep
/models/**
!/models/**/
!/models/**/*.dvc
!/models/**/.gitkeep

# Variáveis de ambiente: o .env real fica na máquina; o .env.example (sem segredo) vai para o Git
.env

# MLflow local: o banco (padrão do MLflow 3) e os artefatos ficam na máquina. O avaliador
# recria os runs com `dvc exp run`; o banco é binário e guarda caminhos absolutos.
mlflow.db
mlruns/
mlartifacts/

# SO / editor
.DS_Store
.vscode/
.idea/
